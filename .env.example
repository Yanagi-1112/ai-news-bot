# Discord Incoming Webhook URL。秘密値なので .env のみへ設定します。
DISCORD_WEBHOOK_URL=

# 同じ紙面を追加のチャンネルにも配信する場合、Webhook URLをカンマ区切りで指定します。
# 既存のDISCORD_WEBHOOK_URLは変更しません。
#DISCORD_ADDITIONAL_WEBHOOK_URLS=https://discord.com/api/webhooks/ID/TOKEN
# 開始時刻まで既存配信だけを継続する場合に、タイムゾーン付きISO日時を指定します。
#DISCORD_ADDITIONAL_WEBHOOKS_START_AT=2026-09-17T08:00:00+09:00

# OpenAI互換APIの接続先・キー・モデル。
# OpenAI: https://api.openai.com/v1 / 例: gpt-5.6-terra
# Google Gemini（OpenAI互換）: https://generativelanguage.googleapis.com/v1beta/openai/ / 例: gemini-3.8-flash（モデル名は例）
# DeepSeek: https://api.deepseek.com / 例: deepseek-v4-flash
# オフラインで動作確認する場合は LLM_API_KEY=stub、BASE_URL=stub、MODEL=stub にします。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

POST_HOUR_JST=8
BREAKING_THRESHOLD=90
DIGEST_MIN_SCORE=60

# Discord上の表示名とアイコン（未設定なら既定: 「未来に先回りする新聞」＋リポジトリ同梱アイコン）
# 名前を変えたくなったらこの1行を書き換えて再起動するだけ
#BOT_DISPLAY_NAME=未来に先回りする新聞
#BOT_AVATAR_URL=https://raw.githubusercontent.com/Yanagi-1112/ai-news-bot/main/docs/icon.png
