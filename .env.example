# Discord Incoming Webhook URL。秘密値なので .env のみへ設定します。
DISCORD_WEBHOOK_URL=

# OpenAI互換APIの接続先・キー・モデル。
# OpenAI: https://api.openai.com/v1 / 例: gpt-5.6-terra
# Google Gemini（OpenAI互換）: https://generativelanguage.googleapis.com/v1beta/openai/ / 例: gemini-3.8-flash（モデル名は例）
# DeepSeek: https://api.deepseek.com / 例: deepseek-v4-flash
# オフラインで動作確認する場合は LLM_API_KEY=stub、BASE_URL=stub、MODEL=stub にします。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

POST_HOUR_JST=8
BREAKING_THRESHOLD=90
